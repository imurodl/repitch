# API mode toggle
# Default: mocks ON (frontend works standalone for the demo).
# Set VITE_DISABLE_MOCK=true to call the real backend defined by VITE_API_BASE_URL.
VITE_DISABLE_MOCK=false

# Real backend base URL (only used when VITE_DISABLE_MOCK=true)
# Backend C runs FastAPI / Python on :8000 by default.
VITE_API_BASE_URL=http://localhost:8000
